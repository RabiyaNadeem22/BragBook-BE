# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Frontend Client URL (for CORS and Cookies)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bragbook?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-bragbook-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Cookie Configuration
COOKIE_NAME="bragbook_token"
